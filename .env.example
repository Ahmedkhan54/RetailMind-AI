MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_local_mysql_password
MYSQL_DATABASE=retail_sales_db
RETAIL_UPLOAD_STORAGE_DIR=C:\path\outside\webroot\retail-user-uploads

# --- Mobile / production security (Problem 61) ---
# Set to true only when the site is served over HTTPS (production).
RETAILMIND_COOKIE_SECURE=false
# Public HTTPS origin of the deployed frontend, e.g. https://app.example.com
RETAILMIND_PUBLIC_ORIGIN=
# Optional service-to-service bearer token for the Python API.
RETAILMIND_API_TOKEN=
# Absolute API URL used by the Next.js same-origin proxy.
RETAILMIND_API_URL=http://127.0.0.1:8000

# --- LLM / RAG (optional; no mock answers are ever used) ---
# openai | ollama | any OpenAI-compatible endpoint. Leave as "none" to keep the
# deterministic extractive RAG answer (clearly labelled in the UI).
RETAILMIND_AI_PROVIDER=none
RETAILMIND_AI_API_KEY=
RETAILMIND_AI_BASE_URL=https://api.openai.com/v1
RETAILMIND_AI_MODEL=gpt-4o-mini
RETAILMIND_AI_EMBEDDING_MODEL=text-embedding-3-small
RETAILMIND_AI_TIMEOUT=30
RETAILMIND_AI_MAX_RETRIES=2
# Heading-aware chunking settings for new RAG documents.
RETAILMIND_RAG_CHUNK_SIZE=900
RETAILMIND_RAG_CHUNK_OVERLAP=120
# Scanned-PDF OCR is optional and needs: pip install pytesseract pdf2image,
# plus the Tesseract executable installed on the server.
# Durable per-user location for RAG indexes and alert status. Defaults to ~/.retailmind
# RETAILMIND_STATE_DIR=

# --- Smart Alert email notifications (optional) ---
# Email is only sent when every required value is present and SMTP accepts it.
RETAILMIND_ALERT_EMAIL_ENABLED=false
RETAILMIND_ALERT_EMAIL_TO=
RETAILMIND_ALERT_MIN_SEVERITY=warning
# instant = one email per alert; daily = one digest on the first alerts check each day.
RETAILMIND_ALERT_FREQUENCY=instant
RETAILMIND_ALERT_AUTO_EMAIL=true
RETAILMIND_SMTP_HOST=
RETAILMIND_SMTP_PORT=587
RETAILMIND_SMTP_USER=
RETAILMIND_SMTP_PASSWORD=
RETAILMIND_SMTP_FROM=
